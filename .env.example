VITE_CONTRACT_ADDRESS=

# Create a project at https://dashboard.reown.com/ and put its Project ID here.
VITE_REOWN_PROJECT_ID=YOUR_PROJECT_ID_HERE

# Informational values; MetaMask supplies the RPC connection.
VITE_NETWORK=sepolia
VITE_CHAIN_ID=11155111
